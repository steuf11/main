# Solana RPC endpoint (use a private RPC for better reliability)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Base58-encoded private key of your trading wallet
# WARNING: Never commit the real value of this variable
SOLANA_WALLET_KEY=<your-base58-encoded-private-key>

# Jupiter API key (optional – public endpoint works without one)
JUPITER_API_KEY=

# Telegram bot credentials
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_CHAT_ID=<your-telegram-chat-id>

# Trading parameters
MAX_TRADE_SIZE_USD=100
SLIPPAGE_TOLERANCE_PCT=0.5
MIN_SPREAD_PCT=0.5
